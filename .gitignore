release/

# Installed dependencies
node_modules/

# Server tarballs are rebuilt by `node package-container-server.cjs <platform>`.
# Only the checksum manifest devcontainers/assets/servers.json is tracked.
devcontainers/assets/*.tar.gz

# macOS metadata
.DS_Store

# Managed upstream, build tools, native dependencies and packages
.build/

# Local credentials and configuration
.env
.env.*
!.env.example
*.pem
*.key
