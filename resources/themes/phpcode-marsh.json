  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7f9585", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#bccb9f" } },
    { "scope": "string", "settings": { "foreground": "#c9c18c" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#ccac89" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#acd0ad" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#99c1b7" } },
    { "scope": "variable.parameter", "settings": { "foreground": "#d6c4a5" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#bccb9f" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#99c1b7" } }
  ]
